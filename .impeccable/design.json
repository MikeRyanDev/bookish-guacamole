  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicit per-call approval action; follows the current accent.",
      "html": "<button class=\"ds-primary\">Allow once</button>",
      "css": ".ds-primary{font-family:\"Manrope Variable\",sans-serif;font-size:13px;border:0;border-radius:6px;padding:7px 12px;cursor:pointer;transition:background 120ms,border-color 120ms;background:var(--accent);border-color:var(--accent);color:var(--on-accent)}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral alternative beside a primary action.",
      "html": "<button class=\"ds-secondary\">Reject</button>",
      "css": ".ds-secondary{font-family:\"Manrope Variable\",sans-serif;font-size:13px;border:0;border-radius:6px;padding:7px 12px;cursor:pointer;transition:background 120ms,border-color 120ms;background:var(--bg);color:var(--text)}.ds-secondary:hover{background:var(--hover)}.ds-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named copy action with an inline SVG icon.",
      "html": "<button class=\"ds-icon\" aria-label=\"Copy command\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></svg></button>",
      "css": ".ds-icon{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;padding:0;border:0;border-radius:6px;background:transparent;color:var(--muted);cursor:pointer;transition:background-color 120ms,color 120ms,transform 120ms}.ds-icon:hover{color:var(--text);background:var(--hover)}.ds-icon:active{transform:scale(.94)}.ds-icon:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}"
    },
    {
      "name": "Session selection",
      "kind": "nav",
      "refersTo": "session-selected",
      "description": "Selected session with tonal fill and no left stripe.",
      "html": "<nav aria-label=\"Sessions\"><a class=\"ds-session\" href=\"#\" aria-current=\"page\">Review workspace changes</a></nav>",
      "css": ".ds-session{font-family:\"Manrope Variable\",sans-serif;font-size:13px;display:block;font-size:12px;padding:10px 8px;text-decoration:none;background:var(--accent-bg);color:var(--accent)}.ds-session:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Session search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Compact unboxed search with an explicit focus indicator.",
      "html": "<label class=\"ds-search\"><input aria-label=\"Search sessions\" placeholder=\"Search sessions\"></label>",
      "css": ".ds-search{display:flex;padding:7px 8px;border:0;border-radius:6px}.ds-search input{font-family:\"Manrope Variable\",sans-serif;font-size:13px;font-size:12px;width:100%;min-width:0;background:transparent;border:0;color:var(--text)}.ds-search input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Tool disclosure",
      "kind": "custom",
      "refersTo": "tool-disclosure",
      "description": "A compact completed read expands into exact source.",
      "html": "<details class=\"ds-tool\"><summary><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg><strong>Read file</strong><span>greet.ts</span><span class=\"ds-status\">Result received</span></summary><pre>export const greeting = \"Hello\";</pre></details>",
      "css": ".ds-tool{font-family:\"Manrope Variable\",sans-serif;font-size:13px;color:var(--text)}.ds-tool summary{display:flex;align-items:center;gap:8px;min-height:38px;padding:6px 2px;border-radius:6px;font-size:12px;color:var(--muted);cursor:pointer;list-style:none}.ds-tool summary::-webkit-details-marker{display:none}.ds-tool summary:hover{background:var(--panel);color:var(--text)}.ds-tool summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-tool strong{font-weight:650;color:var(--text)}.ds-status{margin-left:auto;font-size:11px}.ds-tool[open] svg{transform:rotate(90deg)}.ds-tool pre{font-family:\"IBM Plex Mono\",monospace;font-size:12px;line-height:1.8;background:var(--code);border-radius:8px;padding:12px;overflow:auto}"
    },
    {
      "name": "Permission group",
      "kind": "custom",
      "refersTo": "permission",
      "description": "Unframed proposed call and its per-call decision footer.",
      "html": "<section class=\"ds-permission\" aria-label=\"Tool approval\"><details open><summary><strong>Run command</strong><span class=\"ds-status\">Approval required</span></summary><pre>node --test example/greet.test.js</pre></details><footer><span>This tool call only</span><button>Reject</button><button class=\"ds-allow\">Allow once</button></footer></section>",
      "css": ".ds-permission{font-family:\"Manrope Variable\",sans-serif;font-size:13px;background:transparent;color:var(--text);border:0;padding:0}.ds-permission summary{display:flex;align-items:center;gap:8px;min-height:38px;padding:6px 2px;font-size:12px;cursor:pointer;list-style:none}.ds-permission summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-status{margin-left:auto;color:var(--accent);font-size:11px}.ds-permission footer>span{margin-right:auto;color:var(--muted);font-size:11px}.ds-permission pre{font-family:\"IBM Plex Mono\",monospace;font-size:12px;line-height:1.8;background:var(--code);padding:12px 14px;border-radius:8px;overflow:auto}.ds-permission footer{display:flex;justify-content:flex-end;gap:8px;padding:10px 0}.ds-permission button{font-family:\"Manrope Variable\",sans-serif;font-size:13px;border:0;border-radius:6px;padding:7px 12px;cursor:pointer;transition:background 120ms,border-color 120ms;background:var(--bg);color:var(--text)}.ds-permission button:hover{background:var(--hover)}.ds-permission button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-permission .ds-allow{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}"
    }
  ],
  "narrative": {
    "northStar": "The coding workspace",
    "overview": "A compact, plain, minimal, clean, and elegant interface for sophisticated developers. Linear informs density, restrained hierarchy, coherent controls, and precise feedback. Tool activity is easy to scan and changes are easy to inspect without enclosing every event in a card.",
    "keyCharacteristics": [
      "Soft neutral surfaces with eight warm vintage-rainbow accents.",
      "Manrope interface text and IBM Plex Mono source text.",
      "Flat activity rows, quiet code surfaces, and explicit outcomes.",
      "Equal attention to light, dark, keyboard, and narrow-screen use."
    ],
    "rules": [
      {
        "name": "The Neutral Surface Rule",
        "body": "Keep dark backgrounds nearly achromatic with a trace of blue. Selected accents may tint selection and focus, never the base surface palette.",
        "section": "colors"
      },
      {
        "name": "The Semantic Color Rule",
        "body": "Changing the accent must not change the meaning of errors or added and removed source lines.",
        "section": "colors"
      },
      {
        "name": "The Source Type Rule",
        "body": "Use mono for source, commands, paths, and machine values; use sans-serif for actions and explanations.",
        "section": "typography"
      },
      {
        "name": "The No-Line Default Rule",
        "body": "Start with no border, divider, or card wrapper. Add one only when a concrete usability need cannot be met with spacing, alignment, or a subtle surface change; record that reason.",
        "section": "elevation"
      },
      {
        "name": "The Flat Activity Rule",
        "body": "Separate tool events with spacing and disclosure hierarchy. Keep the meaningful payload in one quiet surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use spacing and alignment before any line or wrapper; justify functional exceptions.",
      "Do keep accessible names on icon controls and keyboard access on every action.",
      "Do use explicit text for approvals, destructive choices, errors, and ambiguous actions.",
      "Do verify both themes, all eight accents, narrow screens, reduced motion, and meaningful loading and error states.",
      "Do preserve CopilotKit v2 message ownership, Router URL ownership, and Query read ownership.",
      "Do treat screenshots under docs/proof/ as historical evidence until checked against current code."
    ],
    "donts": [
      "Don't tint dark neutral surfaces green or turn the subtle blue trace into a blue theme.",
      "Don't display branding, model/container identifiers, idle status, or repeated headings in the working UI.",
      "Don't add decorative left accent stripes, gradients, or shadows to ordinary tool results.",
      "Don't frame every event or region as a card, or add explanatory labels to every control.",
      "Don't use oversized whitespace or marketing typography in workspace panels.",
      "Don't invent line numbers, elapsed time, success states, or other backend facts.",
      "Don't equate a clean source detector scan with visual or accessibility proof."
    ]
  }
}
