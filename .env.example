# Put the keys referenced by models.json and learning.json here. Never commit .env.
# These names are examples; use any apiKeyEnv names you choose.
CODING_PROVIDER_API_KEY=
LEARNING_PROVIDER_API_KEY=
# Optional configuration paths, relative to the repository root.
# CODING_MODELS_FILE=models.json
# LEARNING_MODELS_FILE=learning.json
# `pnpm intelligence local connect --approve-connection` writes these values.
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_API_KEY=
# Create this container in the local Intelligence project before your first run.
LEARNING_CONTAINER_ID=coding-lessons
CODING_WORKSPACE=workspace
