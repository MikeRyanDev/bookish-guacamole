{
  "name": "tanstack-intelligence-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "vite build && tsdown",
    "intelligence": "copilotkit",
    "workspace:create": "node scripts/create-workspace.mjs",
    "lint": "oxlint --deny-warnings src web/src tests scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "NODE_ENV=production node --env-file=.env dist/server/server.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "skills:sync": "intent install --map",
    "skills:list": "intent list",
    "test:e2e": "playwright test",
    "learning:config": "node --env-file=.env scripts/write-learning-config.mjs",
    "intelligence:image:apply": "node scripts/temporary-intelligence-image.mjs apply",
    "intelligence:image:restore": "node scripts/temporary-intelligence-image.mjs restore",
    "intelligence:image:status": "node scripts/temporary-intelligence-image.mjs status"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/core": "1.79.1",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-harness": "0.1.0",
    "@tanstack/ai-openai": "1.0.0",
    "@tanstack/ai-persistence": "1.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.22",
    "copilotkit": "4.29.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.1",
    "sirv": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tanstack/intent": "0.5.6",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.9.0",
  "intent": {
    "skills": [
      "@tanstack/ai",
      "@tanstack/ai-persistence",
      "@tanstack/react-router",
      "@tanstack/router-core"
    ]
  }
}
