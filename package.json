{
  "name": "tanstack-intelligence-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "intelligence": "copilotkit",
    "workspace:create": "node scripts/create-workspace.mjs",
    "lint": "biome check src tests scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-harness": "0.1.0",
    "@tanstack/ai-openai": "1.0.0",
    "@tanstack/ai-persistence": "1.0.0",
    "copilotkit": "4.29.0",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.9.0"
}
